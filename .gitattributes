# This repository is edited on Windows and checked out on a Linux VPS by
# Jenkins. A shell script that reaches the container with CRLF endings fails as:
#
#   exec /usr/local/bin/interview-entrypoint: no such file or directory
#
# because the kernel reads "/bin/sh\r" as the interpreter path. Everything
# executed or parsed inside an image is pinned to LF rather than left to
# whatever the checking-out client happens to be configured for.
* text=auto eol=lf

*.sh         text eol=lf
*.py         text eol=lf
Dockerfile   text eol=lf
Jenkinsfile  text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.php        text eol=lf
*.js         text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.json       text eol=lf
*.ini        text eol=lf
*.conf       text eol=lf
*.txt        text eol=lf
.htaccess    text eol=lf
.env.example text eol=lf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.ico  binary
*.woff  binary
*.woff2 binary
