# Interview Revision Hub — production environment.
#
# Documentation only. The real file is stored encrypted in CloudForge as a
# "Deployment Environment File" credential and is never committed: the pipeline
# decodes it into .env at build time and deletes it in the post block.
#
# Two consumers read these values:
#   - docker-compose.yml, for variable substitution across all three services;
#   - the web container's entrypoint, which renders /var/www/html/.env from
#     them for api.php and ai_proxy.php.
#
# api.php parses that rendered file with a plain explode('=', $line, 2), so
# values must carry no surrounding quotes and no trailing inline comments.
#
# CloudForge refuses to deploy while any value still reads CHANGE_ME_*.

# --- Application login ---------------------------------------------------
# Verified server-side by api.php. There is no hardcoded fallback: if these are
# unset the API returns 503 rather than accepting a default.
APP_USERNAME=abdohero
APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# --- PHP <-> Python trust ------------------------------------------------
# The only thing stopping a direct call to the AI service's internal routes.
# Any long random string; must be identical for both containers, which Compose
# guarantees by injecting this one value into each.
INTERNAL_SHARED_SECRET=CHANGE_ME_INTERNAL_SHARED_SECRET

# --- Voice WebSocket -----------------------------------------------------
# The browser opens the voice socket itself, so it needs a public origin.
# Deriving it from AI_SERVICE_URL would hand the browser ws://ai:8088, a name
# that exists only inside the compose network. Nginx proxies exactly one path,
# /api/voice/ws, to the AI container.
AI_PUBLIC_WS_URL=wss://interview.zincolo.com

# CORS for the AI service. Not what protects it — the internal token and the
# HMAC voice ticket are — but it stops other origins scripting it.
ALLOWED_ORIGINS=https://interview.zincolo.com

# --- LLM providers -------------------------------------------------------
# At least one of OPENAI_API_KEY or GROQ_API_KEY is required; the pipeline
# fails the build rather than deploying an AI service with no provider.
# Voice needs OpenAI specifically — it relays the OpenAI Realtime API.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Also used by api.php for the non-interview chat tab.
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# openai,groq — anthropic is omitted because ANTHROPIC_API_KEY is empty and
# listing an unconfigured provider only adds a failed attempt per call.
LLM_PROVIDER_PRIORITY=openai,groq

# --- Embeddings ----------------------------------------------------------
# With VOYAGE_API_KEY empty the service falls back to OpenAI embeddings. The
# Qdrant collection dimension is derived from whichever embedder is active at
# runtime, so there is no dimension to configure here.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
EMBEDDING_FALLBACK_MODEL=text-embedding-3-small

# --- Vector store --------------------------------------------------------
# QDRANT_URL is set by docker-compose.yml to the container address; it is not
# configurable here on purpose, so the app cannot be pointed at an unintended
# Qdrant.
QDRANT_COLLECTION=interview_knowledge

# --- Limits --------------------------------------------------------------
# Raising this needs matching changes to php.ini (upload_max_filesize) and to
# the Nginx site's body size, or a large upload is rejected before PHP sees it.
MAX_UPLOAD_MB=50

TZ=Africa/Casablanca

# HOST_PORT and AI_HOST_PORT are deliberately absent. CloudForge owns HOST_PORT
# as a Jenkins parameter because it must equal the port the managed Nginx site
# proxies to; AI_HOST_PORT is declared in the Jenkinsfile for the same reason.
