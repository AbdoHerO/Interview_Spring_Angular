# ============================================================
# AI Interview Service — environment configuration
# ============================================================

# --- service ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8088
# Shared secret between PHP <-> Python (proxy adds X-Internal-Token header).
INTERNAL_SHARED_SECRET=change-me-to-a-long-random-string
# CORS: comma-separated origins. In production, restrict to your PHP host.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# --- LLM providers (configure the ones you have) ---
# Primary: OpenAI GPT-4.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# Fallback: Anthropic Claude Sonnet 4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Budget fallback: Groq Llama 4 Scout (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider priority (comma-separated). The first available wins.
LLM_PROVIDER_PRIORITY=openai,anthropic,groq

# --- Embeddings ---
# Primary: Voyage AI voyage-code-3 (code-optimized)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
# Fallback: OpenAI text-embedding-3-small
EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024  # voyage-code-3 is 1024; OpenAI small is 1536 — handled per-collection

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=interview_knowledge

# --- Session store ---
# 'json' (file, shared-hosting friendly) or 'redis'
SESSION_BACKEND=json
SESSION_DIR=./data/sessions
REDIS_URL=redis://localhost:6379/0

# --- Ingestion limits ---
MAX_UPLOAD_MB=50
MAX_REPO_FILES=2000
MAX_REPO_BYTES=20971520     # 20 MB after pruning binaries
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
